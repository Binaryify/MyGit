// Deploys the site to binaryify.com/mygit: npx wrangler deploy, from here.
{
  "name": "mygit-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "binaryify.com/mygit*", "zone_name": "binaryify.com" }]
}
